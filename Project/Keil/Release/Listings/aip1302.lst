 335          /**
 336           * @brief 向aip1302写入数据
 337           *          1. 内部会进行格式转换,以适配寄存器的格式
 338           *          会根据命令,屏蔽传入的数据的一些数据位
 339           *          2. 函数内部在写入前会解开芯片的写保护，写入完成后会打开芯片的写�
             -��护
 340           *
 341           * @param cmd 命令，待写入的寄存器的地址
 342           * @param byte 要写入的1字节数据，函数内部会对数据做好相应的处理，以符合对应
             -的寄存器的格式
 343           *
 344           * @return  void
 345           */
 346          void aip1302_write_byte(const u8 cmd, u8 byte)
 347          {
 348   1          u8 tmp = byte;
 349   1          // 根据命令cmd，将对应的数据做好转换(转换成寄存器中存放的格式)，再写入
 350   1      
 351   1          if (cmd == AIP1302_SEC_REG_ADDR ||
 352   1              cmd == AIP1302_MIN_REG_ADDR ||
 353   1              cmd == AIP1302_HOUR_REG_ADDR ||
 354   1              cmd == AIP1302_DATE_REG_ADDR ||
 355   1              cmd == AIP1302_MONTH_REG_ADDR ||
 356   1              cmd == AIP1302_YEAR_REG_ADDR)
 357   1          {
 358   2              u8 tens_place = 0; // 十位
C51 COMPILER V9.60.7.0   AIP1302                                                           07/02/2025 15:11:51 PAGE 7   

 359   2              u8 one_place = 0;  // 个位
 360   2              if (tmp >= 10)
 361   2              {
 362   3                  tens_place = tmp / 10;
 363   3              }
 364   2              one_place = tmp % 10;
 365   2      
 366   2              // 秒、分钟、小时、日、月、年寄存器都是高4位数据存放以10为单位的数�
             -�，低4位存放以1为单位的数据
 367   2              tmp = tens_place << 4 | one_place;
 368   2              // 秒寄存器中，清除bit7,bit7==0,时钟IC的晶振会继续振荡
 369   2              // 在分钟寄存器的bit7未使用，默认就是0
 370   2              // 年寄存器的bit7存放有效数据，不清零
 371   2              if (AIP1302_SEC_REG_ADDR == cmd || AIP1302_MIN_REG_ADDR == cmd)
 372   2              {
 373   3                  tmp &= ~0x80;
 374   3              }
 375   2              else if (AIP1302_HOUR_REG_ADDR == cmd || AIP1302_DATE_REG_ADDR == cmd)
 376   2              {
 377   3                  // 小时寄存器，清除bit7和bit6，bit7清零，表示使用24h制，bit6未使用
 378   3                  // 日寄存器，bit7和bit6未使用
 379   3                  tmp &= ~0xC0;
 380   3              }
 381   2              else if (AIP1302_MONTH_REG_ADDR == cmd)
 382   2              {
 383   3                  // 月寄存器，bit7~5未使用
 384   3                  tmp &= ~0xE0;
 385   3              }
 386   2          }
 387   1      
 388   1          // 解除写保护
 389   1          __aip1302_write_byte(AIP1302_WRITE_PROTECT_REG_ADDR, 0x00);
 390   1          __aip1302_write_byte(cmd, tmp); // 写入数据
 391   1          // 开启写保护
 392   1          __aip1302_write_byte(AIP1302_WRITE_PROTECT_REG_ADDR, 0x80);
 393   1      }
