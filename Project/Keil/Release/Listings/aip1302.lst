 114   1          u8 i = 0; // 循环计数值
 115   1      
 116   1          // 直接从aip1302读出的数据是LSB低位在前的，这里先做反转
 117   1          tmp = reverse_u8(byte);
 118   1          // printf("val %bx \n", tmp); // 测试反转后的数据
 119   1      
 120   1          // 根据命令，判断是从哪个寄存器读出的数据，在根据手册对应的格式做转换
 121   1          if (cmd == (AIP1302_SEC_REG_ADDR + 1) ||   /* 秒寄存器 */
 122   1              cmd == (AIP1302_MIN_REG_ADDR + 1) ||   /* 分钟寄存器 */
 123   1              cmd == (AIP1302_HOUR_REG_ADDR + 1) ||  /* 小时寄存器 */
 124   1              cmd == (AIP1302_DATE_REG_ADDR + 1) ||  /* 日期寄存器 */
 125   1              cmd == (AIP1302_MONTH_REG_ADDR + 1) || /* 月份寄存器 */
 126   1              cmd == (AIP1302_YEAR_REG_ADDR + 1))    /* 年寄存器 */
 127   1          {
 128   2              u8 tens_place = 0; // 十位
 129   2              u8 one_place = 0;  // 个位
 130   2      
 131   2              if ((AIP1302_SEC_REG_ADDR + 1) == cmd ||
 132   2                  (AIP1302_MIN_REG_ADDR + 1) == cmd)
 133   2              {
 134   3                  // 秒寄存器、分寄存器中中，清除bit7,bit6~bit0才是有效数据
 135   3                  // 如果在时钟芯片上电复位后，没有开启晶振，这里会读取到 tmp==255
 136   3                  tmp &= ~0x80;
 137   3              }
 138   2              else if ((AIP1302_HOUR_REG_ADDR + 1) == cmd || (AIP1302_DATE_REG_ADDR + 1) == cmd)
 139   2              {
 140   3                  // 小时、日寄存器，清除bit7和bit6,未使用
 141   3                  tmp &= ~0xC0;
 142   3              }
 143   2              else if ((AIP1302_MONTH_REG_ADDR + 1) == cmd)
 144   2              {
 145   3                  // 月寄存器，bit7~5未使用
 146   3                  tmp &= ~0xE0;
 147   3              }
 148   2      
 149   2              tens_place = tmp >> 4;
 150   2              one_place = tmp & (~0xF0);
 151   2              tmp = tens_place * 10 + one_place;
 152   2          }
 153   1      
 154   1          return tmp;
 155   1      }
