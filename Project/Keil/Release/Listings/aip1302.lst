  87          // 将8位变量中的数据反转(例：0b 0111 0101  -> 0b 1010 1110)
  88          static u8 reverse_u8(u8 arg)
  89          {
  90   1          u8 tmp;
  91   1          u8 i = 0; // 循环计数值
  92   1      
  93   1          // 直接从aip1302读出的数据是LSB低位在前的，这里先做反转
  94   1          for (i = 0; i < 8; i++)
  95   1          {
  96   2              tmp <<= 1;
  97   2              if (arg & 0x01)
  98   2              {
  99   3                  tmp |= 0x01;
 100   3              }
 101   2              else
 102   2              {
 103   3              }
 104   2              arg >>= 1;
 105   2          }
 106   1      
 107   1          return tmp;
 108   1      }
