  11          u16 conver_adc_val_to_voltage(u16 arg_adc_val)
  12          {
  13   1          /*
  14   1              采集到的ad值范围：0~4095
  15   1              ad值对应的电压： 0 ~ MAX_VOLTAGE_OF_BATTERY
  16   1              那么 每单位ad值对应 MAX_VOLTAGE_OF_BATTERY / 4096
  17   1          */
  18   1          // return (u32)arg_adc_val * MAX_VOLTAGE_OF_BATTERY / 4096;
  19   1         
  20   1          // 使用2.4V参考电压，12位精度
  21   1          // 电池电压是 1/11 分压： 
  22   1          return (u32)arg_adc_val * 240 * 11 / 10 / 4096; 
  23   1      }
  24          
  25          // 将电池电压转换为对应的百分比
  26          // voltage： 0~255 ， 对应0~25.5V
  27          u8 conver_voltage_of_battery_to_percentage(u8 voltage)
  28          {
  29   1          // 用电池电压voltage除以MAX_VOLTAGE_OF_BATTERY，得到占比，再乘以100，得到百分比
  30   1          u8 tmp = (u16)voltage * 100 / MAX_VOLTAGE_OF_BATTERY;
  31   1          // if (tmp >= 98)
  32   1          // {
  33   1          //     // 如果电量百分比大于 98%，当作100%电量处理
  34   1          //     tmp = 100;
  35   1          // }
  36   1      
  37   1          return tmp;
  38   1      }
