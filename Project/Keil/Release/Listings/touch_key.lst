 133          /**
 134           * @brief 将按键值和key_driver_scan得到的按键事件转换成触摸按键的事件
 135           *
 136           * @param key_val 触摸按键键值
 137           * @param key_event 在key_driver_scan得到的按键事件 KEY_EVENT
 138           * @return u8 在touch_key_event_table中找到的对应的按键事件，如果没有则返回 TOUCH_KEY_
             -EVENT_NONE
 139           */
 140          static u8 __touch_key_get_event(const u8 key_val, const u8 key_event)
 141          {
 142   1          volatile u8 ret_key_event = TOUCH_KEY_EVENT_NONE;
 143   1          u8 i = 0;
 144   1          for (; i < ARRAY_SIZE(touch_key_event_table); i++)
 145   1          {
 146   2              // 如果往 KEY_EVENT 枚举中添加了新的按键事件，这里查表的方法就会失效，
             -需要手动修改
 147   2              if (key_val == touch_key_event_table[i][0])
 148   2              {
 149   3                  ret_key_event = touch_key_event_table[i][key_event];
 150   3                  break;
 151   3              }
 152   2          }
 153   1      
 154   1          return ret_key_event;
 155   1      }
