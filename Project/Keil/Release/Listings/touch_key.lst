 135          /**
 136           * @brief 将按键值和key_driver_scan得到的按键事件转换成触摸按键的事件
 137           *
 138           * @param key_val 触摸按键键值
 139           * @param key_event 在key_driver_scan得到的按键事件 KEY_EVENT
 140           * @return u8 在touch_key_event_table中找到的对应的按键事件，如果没有则返回 TOUCH_KEY_
             -EVENT_NONE
 141           */
 142          static u8 __touch_key_get_event(const u8 key_val, const u8 key_event)
 143          {
 144   1          volatile u8 ret_key_event = TOUCH_KEY_EVENT_NONE;
 145   1          u8 i = 0;
 146   1          for (; i < ARRAY_SIZE(touch_key_event_table); i++)
 147   1          {
 148   2              // 如果往 KEY_EVENT 枚举中添加了新的按键事件，这里查表的方法就会失效，
             -需要手动修改
 149   2              if (key_val == touch_key_event_table[i][0])
 150   2              {
 151   3                  ret_key_event = touch_key_event_table[i][key_event];
 152   3                  break;
 153   3              }
 154   2          }
 155   1      
 156   1          return ret_key_event;
 157   1      }
